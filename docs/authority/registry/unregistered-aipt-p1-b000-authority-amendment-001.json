  "amendment_reason": [
    {
      "finding_id": "F1",
      "summary": "The frozen Authority validator applies candidate-only zero-merge and fixed-branch invariants to legitimate merged and post-merge main states.",
      "observed_effect": "The approved candidate, lawful no-fast-forward merge and byte-identical merge tree cannot be accepted on main by the frozen validator."
    },
    {
      "finding_id": "F2",
      "summary": "The B001 validator selects active-candidate mutation probes for the immutable historical CLOSED state.",
      "observed_effect": "The validator dereferences an absent pending_candidate and throws an unstructured TypeError instead of producing a structured failure report."
    },
    {
      "finding_id": "F3",
      "summary": "The lawful Authority merge has no GitHub check run even though post-merge main CI was required.",
      "observed_effect": "The immutable fact is original_merge_check_run equals ABSENT; a narrow exact-target reverification path is required without inventing a historical PASS."
    }
  ],
