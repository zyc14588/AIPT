{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zyc14588/AIPT/schemas/evidence/v1/aipt-evidence.schema.json",
  "title": "AIPT Evidence/Audit v1 canonical manifest schema",
  "description": "The public, versioned Evidence/Audit manifest contract. The executable root accepts exactly RAW_CAPTURE, AUDIT_READY, or AUDIT_RESULT. Every object fails closed on unknown fields and every version/stage is a const. RAW_CAPTURE is the only stage generated by B006; the later-stage definitions are schema contracts only.",
  "oneOf": [
    { "$ref": "#/$defs/raw_capture_manifest" },
    { "$ref": "#/$defs/audit_ready_manifest" },
    { "$ref": "#/$defs/audit_result_manifest" }
  ],
  "$defs": {
    "schema_id": { "const": "aipt.evidence/v1" },
    "schema_version": { "const": "1.0.0" },
    "normalization_version": { "const": "aipt.raw-capture/v1" },
    "sha256_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_object_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "ledger_text": {
      "description": "Nonempty ledger identity text. B006 does not narrow the B003 valid UTF-8 ledger domain.",
      "type": "string",
      "minLength": 1
    },
    "asset_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^https://\\S+$"
        },
        "commit": { "$ref": "#/$defs/git_object_id" },
        "tree": { "$ref": "#/$defs/git_object_id" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/asset_path" },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": { "$ref": "#/$defs/sha256_hex" }
      }
    },
    "raw_events_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "bytes", "sha256"],
      "properties": {
        "path": { "const": "events.ndjson" },
        "media_type": { "const": "application/x-ndjson" },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": { "$ref": "#/$defs/sha256_hex" }
      }
    },
    "raw_capture_manifest": {
      "title": "Native ledger RAW_CAPTURE manifest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "version", "stage", "source", "capture_kind", "stream_id",
        "event_count", "tail_sequence", "tail_event_hash", "normalization_version", "assets"
      ],
      "properties": {
        "schema": { "$ref": "#/$defs/schema_id" },
        "version": { "$ref": "#/$defs/schema_version" },
        "stage": { "const": "RAW_CAPTURE" },
        "source": { "$ref": "#/$defs/source_identity" },
        "capture_kind": { "const": "LEDGER_STREAM" },
        "stream_id": { "$ref": "#/$defs/ledger_text" },
        "event_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tail_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tail_event_hash": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256_hex" }
          ]
        },
        "normalization_version": { "$ref": "#/$defs/normalization_version" },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/raw_events_asset" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "event_count": { "const": 0 },
            "tail_sequence": { "const": 0 },
            "tail_event_hash": { "type": "null" }
          }
        },
        {
          "properties": {
            "event_count": { "type": "integer", "minimum": 1 },
            "tail_sequence": { "type": "integer", "minimum": 1 },
            "tail_event_hash": { "$ref": "#/$defs/sha256_hex" }
          }
        }
      ]
    },
    "remote_immutable_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "commit", "status"],
      "properties": {
        "remote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^https://\\S+$"
        },
        "commit": { "$ref": "#/$defs/git_object_id" },
        "status": { "const": "VERIFIED_IMMUTABLE_REMOTE_COMMIT" }
      }
    },
    "unencrypted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "UNENCRYPTED" }
      }
    },
    "encrypted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scheme", "key_reference"],
      "properties": {
        "status": { "const": "ENCRYPTED" },
        "scheme": { "type": "string", "minLength": 1, "maxLength": 128 },
        "key_reference": { "$ref": "#/$defs/identifier" }
      }
    },
    "disclosure_public": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "contains_unpublished_content", "encryption"],
      "properties": {
        "profile": { "const": "PUBLIC" },
        "contains_unpublished_content": { "const": false },
        "encryption": {
          "oneOf": [
            { "$ref": "#/$defs/unencrypted" },
            { "$ref": "#/$defs/encrypted" }
          ]
        }
      }
    },
    "disclosure_external_published": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "contains_unpublished_content", "encryption"],
      "properties": {
        "profile": { "const": "EXTERNAL_AUDITOR" },
        "contains_unpublished_content": { "const": false },
        "encryption": {
          "oneOf": [
            { "$ref": "#/$defs/unencrypted" },
            { "$ref": "#/$defs/encrypted" }
          ]
        }
      }
    },
    "disclosure_external_unpublished": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "contains_unpublished_content", "encryption"],
      "properties": {
        "profile": { "const": "EXTERNAL_AUDITOR" },
        "contains_unpublished_content": { "const": true },
        "encryption": { "$ref": "#/$defs/encrypted" }
      }
    },
    "disclosure_private": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "contains_unpublished_content", "encryption"],
      "properties": {
        "profile": { "const": "PRIVATE_FULL" },
        "contains_unpublished_content": { "type": "boolean" },
        "encryption": { "$ref": "#/$defs/encrypted" }
      }
    },
    "disclosure": {
      "oneOf": [
        { "$ref": "#/$defs/disclosure_public" },
        { "$ref": "#/$defs/disclosure_external_published" },
        { "$ref": "#/$defs/disclosure_external_unpublished" },
        { "$ref": "#/$defs/disclosure_private" }
      ]
    },
    "audit_ready_manifest": {
      "title": "Normalized AUDIT_READY manifest contract",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "version", "stage", "raw_capture_root", "source",
        "remote_verification", "disclosure", "normalization_version", "normalized_assets"
      ],
      "properties": {
        "schema": { "$ref": "#/$defs/schema_id" },
        "version": { "$ref": "#/$defs/schema_version" },
        "stage": { "const": "AUDIT_READY" },
        "raw_capture_root": { "$ref": "#/$defs/sha256_hex" },
        "source": { "$ref": "#/$defs/source_identity" },
        "remote_verification": { "$ref": "#/$defs/remote_immutable_verification" },
        "disclosure": { "$ref": "#/$defs/disclosure" },
        "normalization_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "normalized_assets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/asset" }
        }
      }
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "profile", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["MODEL", "HUMAN", "TOOL"] },
        "profile": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "category", "summary", "evidence_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"] },
        "category": { "$ref": "#/$defs/identifier" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/asset_path" }
        }
      }
    },
    "audit_result_manifest": {
      "title": "Structured AUDIT_RESULT manifest contract",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "stage", "audit_ready_root", "auditor", "verdict", "findings"],
      "properties": {
        "schema": { "$ref": "#/$defs/schema_id" },
        "version": { "$ref": "#/$defs/schema_version" },
        "stage": { "const": "AUDIT_RESULT" },
        "audit_ready_root": { "$ref": "#/$defs/sha256_hex" },
        "auditor": { "$ref": "#/$defs/auditor" },
        "verdict": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/finding" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "verdict": { "const": "PASS" },
            "findings": { "maxItems": 0 }
          }
        },
        {
          "properties": {
            "verdict": { "enum": ["FAIL", "BLOCKED"] },
            "findings": { "minItems": 1 }
          }
        }
      ]
    },
    "raw_event": {
      "title": "One canonical line in events.ndjson",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "version", "stream_id", "sequence", "event_id", "event_type",
        "payload_canonical", "payload_sha256", "prev_event_hash", "event_hash", "committed_at"
      ],
      "properties": {
        "schema": { "const": "aipt.evidence.raw-event/v1" },
        "version": { "$ref": "#/$defs/schema_version" },
        "stream_id": { "$ref": "#/$defs/ledger_text" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "event_id": { "$ref": "#/$defs/ledger_text" },
        "event_type": { "$ref": "#/$defs/ledger_text" },
        "payload_canonical": { "type": "string", "minLength": 1 },
        "payload_sha256": { "$ref": "#/$defs/sha256_hex" },
        "prev_event_hash": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256_hex" }
          ]
        },
        "event_hash": { "$ref": "#/$defs/sha256_hex" },
        "committed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
        }
      }
    }
  }
}
