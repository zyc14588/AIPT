{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zyc14588/AIPT/schemas/evidence/v1/aipt-defect-contracts.schema.json",
  "title": "AIPT Defect Contracts v1",
  "description": "Additive B005 contracts separating deterministic defect family identity, concrete occurrence evidence, and Authority-supplied append-only state decisions.",
  "oneOf": [
    {"$ref": "#/$defs/family"},
    {"$ref": "#/$defs/occurrence"},
    {"$ref": "#/$defs/families"},
    {"$ref": "#/$defs/occurrences"},
    {"$ref": "#/$defs/state_policy"},
    {"$ref": "#/$defs/decision"}
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "root_cause": {"enum": ["RULE_PROSE", "MACHINE_RULE", "MODULE", "ADAPTER", "AIPT", "MODEL"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^https://\\S+$"},
        "commit": {"$ref": "#/$defs/git_oid"},
        "tree": {"$ref": "#/$defs/git_oid"}
      }
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "root_cause_domain", "semantic_key", "rule_ids", "invariant_ids"],
      "properties": {
        "version": {"const": "aipt.defect-fingerprint/v1"},
        "root_cause_domain": {"$ref": "#/$defs/root_cause"},
        "semantic_key": {"$ref": "#/$defs/identifier"},
        "rule_ids": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "invariant_ids": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "family_id", "fingerprint_version", "fingerprint", "fingerprint_projection", "root_cause_domain", "severity", "confidence", "reproducibility", "scope", "priority"],
      "properties": {
        "schema": {"const": "aipt.defect-family/v1"},
        "version": {"const": "1.0.0"},
        "family_id": {"$ref": "#/$defs/identifier"},
        "fingerprint_version": {"const": "aipt.defect-fingerprint/v1"},
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "fingerprint_projection": {"$ref": "#/$defs/projection"},
        "root_cause_domain": {"$ref": "#/$defs/root_cause"},
        "severity": {"$ref": "#/$defs/identifier"},
        "confidence": {"$ref": "#/$defs/identifier"},
        "reproducibility": {"$ref": "#/$defs/identifier"},
        "scope": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "priority": {"$ref": "#/$defs/identifier"}
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "occurrence_id", "family_fingerprint", "run_id", "source", "root_cause_domain", "severity", "confidence", "reproducibility", "scope", "priority", "evidence_references", "reproduction_reference", "observed_context_sha256"],
      "properties": {
        "schema": {"const": "aipt.defect-occurrence/v1"},
        "version": {"const": "1.0.0"},
        "occurrence_id": {"$ref": "#/$defs/identifier"},
        "family_fingerprint": {"$ref": "#/$defs/sha256"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "source": {"$ref": "#/$defs/source"},
        "root_cause_domain": {"$ref": "#/$defs/root_cause"},
        "severity": {"$ref": "#/$defs/identifier"},
        "confidence": {"$ref": "#/$defs/identifier"},
        "reproducibility": {"$ref": "#/$defs/identifier"},
        "scope": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "priority": {"$ref": "#/$defs/identifier"},
        "evidence_references": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"$ref": "#/$defs/evidence_reference"}},
        "reproduction_reference": {"$ref": "#/$defs/evidence_reference"},
        "observed_context_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "families": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "families"],
      "properties": {
        "schema": {"const": "aipt.defect-families/v1"},
        "version": {"const": "1.0.0"},
        "families": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/family"}}
      }
    },
    "occurrences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "occurrences"],
      "properties": {
        "schema": {"const": "aipt.defect-occurrences/v1"},
        "version": {"const": "1.0.0"},
        "occurrences": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/occurrence"}}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"$ref": "#/$defs/identifier"},
        "to": {"$ref": "#/$defs/identifier"}
      }
    },
    "state_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "policy_id", "states", "initial_state", "terminal_states", "transitions"],
      "properties": {
        "schema": {"const": "aipt.defect-state-policy/v1"},
        "version": {"const": "1.0.0"},
        "policy_id": {"$ref": "#/$defs/identifier"},
        "states": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "initial_state": {"$ref": "#/$defs/identifier"},
        "terminal_states": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "transitions": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/transition"}}
      }
    },
    "nullable_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "decision_id", "sequence", "predecessor_decision_sha256", "family_fingerprint", "from_state", "to_state", "authority_id", "rationale_sha256"],
      "properties": {
        "schema": {"const": "aipt.defect-adjudication/v1"},
        "version": {"const": "1.0.0"},
        "decision_id": {"$ref": "#/$defs/identifier"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 100000},
        "predecessor_decision_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "family_fingerprint": {"$ref": "#/$defs/sha256"},
        "from_state": {"$ref": "#/$defs/identifier"},
        "to_state": {"$ref": "#/$defs/identifier"},
        "authority_id": {"$ref": "#/$defs/identifier"},
        "rationale_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
