{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zyc14588/AIPT/schemas/evidence/v1/aipt-audit-ready-bundle-index.schema.json",
  "title": "AIPT AUDIT_READY Bundle Index v1",
  "description": "Deterministic logical-to-physical mapping for inline and SHA-256 content-addressed evidence. Core evidence classifications are explicit identity-bound authority; deployment profiles supply thresholds and hard limits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "core_evidence_classifications", "export_profile", "logical_assets"],
  "properties": {
    "schema": {"const": "aipt.audit-ready.bundle-index/v1"},
    "version": {"const": "1.0.0"},
    "core_evidence_classifications": {"$ref": "#/$defs/core_evidence_classifications"},
    "export_profile": {"$ref": "#/$defs/export_profile"},
    "logical_assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/logical_asset"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/-]{0,255}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification": {"enum": ["PUBLIC", "UNRELEASED_REMOTE_ALLOWED", "TABLE_HIDDEN_REMOTE_ALLOWED", "LOCAL_ONLY_SECRET", "HUMAN_PRIVATE_DATA", "CREDENTIAL_SECRET"]},
    "logical_path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"},
    "physical_path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"},
    "core_evidence_classifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "raw_capture", "run_evidence_closure", "replay_evidence", "defect_family", "defect_occurrence", "run_report", "report_derivatives"],
      "properties": {
        "schema": {"const": "aipt.core-evidence-classification/v1"},
        "version": {"const": "1.0.0"},
        "raw_capture": {"$ref": "#/$defs/classification"},
        "run_evidence_closure": {"$ref": "#/$defs/classification"},
        "replay_evidence": {"$ref": "#/$defs/classification"},
        "defect_family": {"$ref": "#/$defs/classification"},
        "defect_occurrence": {"$ref": "#/$defs/classification"},
        "run_report": {"$ref": "#/$defs/classification"},
        "report_derivatives": {"$ref": "#/$defs/classification"}
      }
    },
    "export_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "inline_threshold", "chunk_size", "max_asset_bytes", "max_total_bytes", "max_assets", "max_chunks"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/identifier"},
        "inline_threshold": {"type": "integer", "minimum": 0, "maximum": 134217728},
        "chunk_size": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "max_asset_bytes": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "max_assets": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_chunks": {"type": "integer", "minimum": 1, "maximum": 100000}
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "path", "bytes", "sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 99999},
        "path": {"type": "string", "pattern": "^chunk-[0-9a-f]{64}\\.bin$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 134217728},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inline_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {"const": "INLINE"},
        "path": {"type": "string", "pattern": "^inline-[0-9a-f]{64}\\.asset$"}
      }
    },
    "chunk_storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "chunks"],
      "properties": {
        "kind": {"const": "CONTENT_ADDRESSED_CHUNKS"},
        "chunks": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/chunk"}}
      }
    },
    "logical_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "bytes", "sha256", "classification", "content_kind", "storage"],
      "properties": {
        "path": {"$ref": "#/$defs/logical_path"},
        "media_type": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 134217728},
        "sha256": {"$ref": "#/$defs/sha256"},
        "classification": {"$ref": "#/$defs/classification"},
        "content_kind": {"enum": ["CONTRACT", "RAW_CAPTURE", "REPORT_DERIVATIVE", "SUPPLEMENTAL", "PRIVATE_PROMPT", "CREDENTIAL", "PRIVATE_ASSET_LOCATOR", "GAME_BODY"]},
        "storage": {
          "oneOf": [
            {"$ref": "#/$defs/inline_storage"},
            {"$ref": "#/$defs/chunk_storage"}
          ]
        }
      }
    }
  }
}
