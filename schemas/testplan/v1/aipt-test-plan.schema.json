{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zyc14588/AIPT/schemas/testplan/v1/aipt-test-plan.schema.json",
  "title": "AIPT declarative Test Plan v1",
  "description": "Versioned declarative Test Plan. The only user-visible hierarchy is Campaign -> Suite -> Case -> Run; Attempt policy is metadata inside Run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "campaigns"],
  "properties": {
    "schema": { "const": "aipt.test-plan/v1" },
    "plan_id": { "$ref": "#/$defs/identity" },
    "campaigns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/campaign" } }
  },
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/-]{0,127}$" },
    "taskType": {
      "enum": ["SYSTEM_QUALIFICATION", "RULE", "PROSE", "ORACLE", "HUMAN_SIMULATION", "ADVERSARIAL", "PACKAGE_BUILD", "CALIBRATION", "REGRESSION"]
    },
    "campaign": {
      "type": "object", "additionalProperties": false,
      "required": ["campaign_id", "name", "suites"],
      "properties": {
        "campaign_id": { "$ref": "#/$defs/identity" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "suites": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/suite" } }
      }
    },
    "suite": {
      "type": "object", "additionalProperties": false,
      "required": ["suite_id", "name", "cases"],
      "properties": {
        "suite_id": { "$ref": "#/$defs/identity" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "name", "task_type", "runs"],
      "properties": {
        "case_id": { "$ref": "#/$defs/identity" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "task_type": { "$ref": "#/$defs/taskType" },
        "runs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/run" } }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "run_type", "manifest_id", "attempt_policy"],
      "properties": {
        "run_id": { "$ref": "#/$defs/identity" },
        "run_type": { "$ref": "#/$defs/taskType" },
        "manifest_id": { "$ref": "#/$defs/identity" },
        "attempt_policy": { "$ref": "#/$defs/attemptPolicy" }
      }
    },
    "attemptPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "max_attempts"],
      "properties": {
        "scope": { "const": "RUN_INTERNAL_ONLY" },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    }
  }
}
