{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipt.invalid/schemas/model/v1/aipt-model-profile.schema.json",
  "title": "AIPT governed model profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "profile_id", "profile_version", "backend_kind", "provider_identity",
    "model_id", "harness_identity", "sampling_profile_id", "structured_output_mode",
    "tool_call_mode", "context_policy", "data_egress_policy", "capability_requirements",
    "certification_identity", "sha256"
  ],
  "properties": {
    "schema": { "const": "aipt.model-profile/v1" },
    "profile_id": { "$ref": "#/$defs/identity" },
    "profile_version": { "$ref": "#/$defs/version" },
    "backend_kind": { "enum": ["REMOTE_DEEPSEEK", "LOCAL_LLAMACPP"] },
    "provider_identity": { "$ref": "#/$defs/identity" },
    "model_id": { "$ref": "#/$defs/identity" },
    "harness_identity": { "$ref": "#/$defs/harness" },
    "sampling_profile_id": { "$ref": "#/$defs/identity" },
    "structured_output_mode": { "enum": ["NATIVE_SCHEMA", "PROMPTED", "BOUNDED_REPAIR"] },
    "tool_call_mode": { "enum": ["DISABLED", "NATIVE", "EMULATED"] },
    "context_policy": { "$ref": "#/$defs/contextPolicy" },
    "data_egress_policy": { "$ref": "#/$defs/egressPolicy" },
    "credential_reference": { "$ref": "#/$defs/credentialReference" },
    "local_runtime_identity": { "$ref": "#/$defs/localRuntimeIdentity" },
    "capability_requirements": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "certification_identity": { "$ref": "#/$defs/identity" },
    "sha256": { "$ref": "#/$defs/sha256" }
  },
  "oneOf": [
    {
      "properties": {
        "backend_kind": { "const": "REMOTE_DEEPSEEK" },
        "provider_identity": { "const": "deepseek-official" },
        "model_id": { "const": "deepseek-v4-pro" }
      },
      "required": ["credential_reference"],
      "not": { "required": ["local_runtime_identity"] }
    },
    {
      "properties": {
        "backend_kind": { "const": "LOCAL_LLAMACPP" },
        "provider_identity": { "const": "llama.cpp" }
      },
      "required": ["local_runtime_identity"],
      "not": { "required": ["credential_reference"] }
    }
  ],
  "$defs": {
    "identity": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/\\-]{0,127}$" },
    "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}(?:-[0-9A-Za-z]+(?:\\.[0-9A-Za-z]+)*)?$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "capability": {
      "enum": [
        "basic_completion", "structured_output_native", "structured_output_prompted",
        "structured_output_repair", "tool_call_native", "tool_call_emulated",
        "context_budget", "role_invocation", "transport_stability",
        "visibility_policy_compatible", "prompt_injection_boundary_compatible"
      ]
    },
    "harness": {
      "type": "object", "additionalProperties": false,
      "required": [
		"implementation", "version", "commit", "package_sha256", "protocol_identity",
		"protocol_version", "capability_fingerprint", "runtime_closure_kind", "runtime_closure_sha256"
      ],
      "properties": {
        "implementation": { "$ref": "#/$defs/identity" },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "commit": { "$ref": "#/$defs/gitOid" },
        "package_sha256": { "$ref": "#/$defs/sha256" },
        "protocol_identity": { "const": "agent-client-protocol" },
        "protocol_version": { "const": "1" },
		"capability_fingerprint": { "$ref": "#/$defs/sha256" },
		"runtime_closure_kind": { "const": "VERIFIED_SINGLE_FILE_DATA_URL_V1" },
		"runtime_closure_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "contextPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "policy_version", "max_request_bytes", "max_context_bytes", "reduction_policy_id"],
      "properties": {
        "policy_id": { "$ref": "#/$defs/identity" },
        "policy_version": { "$ref": "#/$defs/version" },
        "max_request_bytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
        "max_context_bytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
        "reduction_policy_id": { "const": "AIPT_CONTEXT_BUDGET_REDUCE_V1" }
      }
    },
    "egressPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_id", "policy_version", "allowed_classifications", "break_glass_allowed"],
      "properties": {
        "policy_id": { "$ref": "#/$defs/identity" },
        "policy_version": { "$ref": "#/$defs/version" },
        "allowed_classifications": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {
            "enum": [
              "PUBLIC", "UNRELEASED_REMOTE_ALLOWED", "TABLE_HIDDEN_REMOTE_ALLOWED",
              "LOCAL_ONLY_SECRET", "SYSTEM_INTERNAL"
            ]
          }
        },
        "break_glass_allowed": { "type": "boolean" }
      }
    },
    "credentialReference": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_id", "kind", "locator"],
      "properties": {
        "reference_id": { "$ref": "#/$defs/identity" },
        "kind": { "enum": ["ENVIRONMENT_VARIABLE", "ENCRYPTED_LOCAL_FILE"] },
        "locator": { "$ref": "#/$defs/identity" }
      }
    },
    "hardware": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture", "cpu_class", "gpu_backend", "memory_class"],
      "properties": {
        "architecture": { "$ref": "#/$defs/identity" },
        "cpu_class": { "$ref": "#/$defs/identity" },
        "gpu_backend": { "$ref": "#/$defs/identity" },
        "memory_class": { "$ref": "#/$defs/identity" }
      }
    },
    "localRuntimeIdentity": {
      "type": "object", "additionalProperties": false,
      "required": [
        "executable_reference", "binary_sha256", "version", "commit", "gguf_reference",
        "gguf_sha256", "gguf_model_identity", "quantization_identity", "template_identity",
		"template_sha256", "isolation_identity", "isolation_helper_reference",
		"isolation_helper_sha256", "launch_parameters", "hardware"
      ],
      "properties": {
        "executable_reference": { "$ref": "#/$defs/identity" },
        "binary_sha256": { "$ref": "#/$defs/sha256" },
        "version": { "$ref": "#/$defs/version" },
        "commit": { "anyOf": [{ "$ref": "#/$defs/gitOid" }, { "const": "" }] },
        "gguf_reference": { "$ref": "#/$defs/identity" },
        "gguf_sha256": { "$ref": "#/$defs/sha256" },
        "gguf_model_identity": { "$ref": "#/$defs/identity" },
        "quantization_identity": { "$ref": "#/$defs/identity" },
        "template_identity": { "$ref": "#/$defs/identity" },
		"template_sha256": { "$ref": "#/$defs/sha256" },
		"isolation_identity": { "const": "AIPT_LINUX_USER_NETNS_SUPERVISOR_V1" },
		"isolation_helper_reference": { "$ref": "#/$defs/identity" },
		"isolation_helper_sha256": { "$ref": "#/$defs/sha256" },
        "launch_parameters": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "hardware": { "$ref": "#/$defs/hardware" }
      }
    }
  }
}
