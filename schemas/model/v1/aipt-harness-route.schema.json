{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipt.invalid/schemas/model/v1/aipt-harness-route.schema.json",
  "title": "AIPT private Harness process route v1",
  "description": "Private runtime input. It is never an evidence or Run Manifest format.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "profile_binding", "sampling_binding", "backend_kind", "provider_identity",
    "model_id", "harness_identity", "harness_protocol_identity", "harness_protocol_version",
    "capability_fingerprint", "structured_output_mode", "tool_call_mode",
    "session_working_directory", "child"
  ],
  "properties": {
    "schema": { "const": "aipt.harness-route/v1" },
    "profile_binding": { "$ref": "#/$defs/bounded" },
    "sampling_binding": { "$ref": "#/$defs/bounded" },
    "backend_kind": { "enum": ["REMOTE_DEEPSEEK", "LOCAL_LLAMACPP"] },
    "provider_identity": { "$ref": "#/$defs/bounded" },
    "model_id": { "$ref": "#/$defs/bounded" },
    "harness_identity": { "$ref": "#/$defs/bounded" },
    "harness_protocol_identity": { "const": "agent-client-protocol" },
    "harness_protocol_version": { "const": "1" },
    "capability_fingerprint": { "$ref": "#/$defs/sha256" },
    "structured_output_mode": { "enum": ["PROMPTED", "BOUNDED_REPAIR"] },
    "tool_call_mode": { "const": "DISABLED" },
    "session_working_directory": { "$ref": "#/$defs/privatePath" },
    "child": { "$ref": "#/$defs/child" }
  },
  "$defs": {
    "bounded": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "privatePath": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "environmentName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
    "argumentDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "sha256"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 63 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "child": {
      "type": "object", "additionalProperties": false,
      "required": [
        "executable_path", "executable_sha256", "arguments", "argument_file_digests",
        "working_directory", "environment_allowlist", "startup_timeout_ms",
        "request_timeout_ms", "shutdown_timeout_ms", "output_budget"
      ],
      "properties": {
        "executable_path": { "$ref": "#/$defs/privatePath" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "arguments": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "argument_file_digests": {
          "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/argumentDigest" }
        },
        "working_directory": { "$ref": "#/$defs/privatePath" },
        "environment_allowlist": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": { "$ref": "#/$defs/environmentName" }
        },
        "startup_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "request_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "shutdown_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "output_budget": { "$ref": "#/$defs/outputBudget" }
      }
    },
    "outputBudget": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema", "max_stdout_protocol_bytes", "max_notification_bytes",
        "max_response_and_notification_bytes", "max_stderr_bytes"
      ],
      "properties": {
        "schema": { "const": "aipt.acp-output-budget/v1" },
        "max_stdout_protocol_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "max_notification_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "max_response_and_notification_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "max_stderr_bytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
      }
    }
  }
}
