{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zyc14588/AIPT/schemas/run-core/v1/aipt-run-state.schema.json",
  "title": "AIPT authoritative derived Run state v1",
  "description": "A complete replayable state value derived from the authoritative ledger. Root seed material is not representable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "binding", "sequence", "rng_version", "commitment_version", "seed_commitment", "rng_cursors", "domain_state"],
  "properties": {
    "schema": { "const": "aipt.run-state/v1" },
    "binding": { "$ref": "#/$defs/binding" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "rng_version": { "const": "AIPT_RNG_HMAC_SHA256_V1" },
    "commitment_version": { "const": "AIPT_SEED_COMMITMENT_SHA256_V1" },
    "seed_commitment": { "$ref": "#/$defs/sha256" },
    "rng_cursors": {
      "type": "object",
      "maxProperties": 4096,
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
    },
    "domain_state": {}
  },
  "$defs": {
    "identity": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+/-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schema", "canonical_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "schema": { "$ref": "#/$defs/identity" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourcePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "schema", "repository", "commit", "tree", "canonical_sha256"],
      "properties": {
        "package_id": { "$ref": "#/$defs/identity" },
        "schema": { "$ref": "#/$defs/identity" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
        "commit": { "$ref": "#/$defs/gitOid" },
        "tree": { "$ref": "#/$defs/gitOid" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "run_id", "manifest", "runtime_adapter_input", "source_package"],
      "properties": {
        "schema": { "const": "aipt.run-binding/v1" },
        "run_id": { "$ref": "#/$defs/identity" },
        "manifest": { "$ref": "#/$defs/artifact" },
        "runtime_adapter_input": { "$ref": "#/$defs/artifact" },
        "source_package": { "$ref": "#/$defs/sourcePackage" }
      }
    }
  }
}
