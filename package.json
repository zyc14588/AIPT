{
  "name": "aipt",
  "version": "0.0.0",
  "private": true,
  "description": "AIPT — deterministic AI-seated TRPG table-testing system. AIPT-MVP-B005 is the authorized private construction batch for offline deterministic Run evidence closure and AUDIT_READY export.",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "check": "node scripts/ci/run-checks.mjs",
    "check:protocol-assets": "node scripts/ci/validate/protocol-assets.mjs",
    "check:adapter-sdk": "node scripts/ci/validate/adapter-sdk.mjs",
    "check:storage": "node scripts/ci/validate/storage.mjs",
    "check:runtime-shell": "node scripts/ci/validate/runtime-shell.mjs",
    "check:harness-adapter": "node scripts/ci/validate/harness-adapter.mjs",
    "check:evidence": "node scripts/ci/validate/evidence.mjs",
    "check:web-ui": "node scripts/ci/validate/mvp-b001.mjs --historical-web",
    "check:m0-development-pass": "node scripts/ci/validate/historical-governance.mjs --gate m0-development-pass",
    "check:mvp-bootstrap": "node scripts/ci/validate/historical-governance.mjs --gate mvp-bootstrap",
    "check:mvp-b001": "node scripts/ci/validate/mvp-b001-regression.mjs",
    "check:mvp-b002": "node scripts/ci/validate/mvp-b002.mjs",
    "check:mvp-b003": "node scripts/ci/validate/mvp-b003.mjs",
    "check:mvp-b004": "node scripts/ci/validate/mvp-b004.mjs",
    "check:mvp-b005": "node scripts/ci/validate/mvp-b005.mjs",
    "check:int001-closeout-authority": "node scripts/ci/validate/int001-closeout-authority.mjs",
    "check:p1-b000-authority": "node scripts/ci/validate/historical-governance.mjs --gate p1-b000-authority",
    "check:p1-b000-authority-amendment": "node scripts/ci/validate/historical-governance.mjs --gate p1-b000-authority-amendment",
    "check:p1-b000-authority-amendment-002": "node scripts/ci/validate/p1-b000-authority-amendment-002.mjs",
    "check:p1-b000-authority-amendment-003": "node scripts/ci/validate/historical-governance.mjs --gate p1-b000-authority-amendment-003",
    "check:p1-b000-authority-amendment-003:historical-replay": "node scripts/ci/validate/historical-governance.mjs --gate p1-b000-authority-amendment-003 --historical-only",
    "check:authority-lifecycle-current": "node scripts/ci/validate/historical-governance.mjs --gate p1-b000-authority-amendment-003 --current-only",
    "check:p1-b000-authority-repair": "node scripts/ci/validate/p1-b000-authority-amendment-003.mjs --closed-governance-gate repair",
    "check:p1-b000-authority-closeout": "node scripts/ci/validate/p1-b000-authority-amendment-003.mjs --closed-governance-gate closeout",
    "check:p1-b000-post-merge-reverification": "node scripts/ci/validate/p1-b000-authority-amendment-003.mjs --closed-governance-gate reverification",
    "check:historical-governance": "node scripts/ci/validate/historical-governance.mjs",
    "test:adapter-sdk": "pnpm --filter @aipt/adapter-sdk test",
    "test:protocol-go": "go test ./internal/protocol -count=1",
    "test:harness-adapter": "pnpm --filter @aipt/harness-adapter test",
    "test:evidence-go": "go test ./internal/evidence -count=1",
    "test:audit-ready-go": "go test ./internal/evidence ./cmd/aipt-audit-ready -count=1",
    "test:web-ui": "pnpm --filter @aipt/web-ui test",
    "test:web-go": "go test ./internal/web -count=1",
    "test:run-core": "go test ./internal/runcore -count=1",
    "test:orchestrator": "go test ./internal/orchestrator -count=1",
    "test:model-gateway": "go test ./internal/modelgateway -count=1",
    "test:model-harness-gateway": "pnpm --filter @aipt/model-harness-gateway test",
    "test:publication-hygiene": "node --test scripts/ci/test/publication-hygiene.test.mjs",
    "smoke:web-ui": "go test ./internal/web -run '^TestLiveLoopbackSmoke$' -count=1 -v",
    "check:retro": "node scripts/ci/validate/b000-retro.mjs",
    "check:supply-chain": "node scripts/ci/validate/supply-chain.mjs",
    "check:sbom": "node scripts/ci/validate/sbom.mjs",
    "sbom": "node scripts/ci/sbom/generate-sbom.mjs",
    "provenance": "node scripts/ci/provenance.mjs"
  }
}
